{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yutna/mycelia/schemas/conformance-fixture.schema.json",
  "title": "Mycelia Conformance Fixture",
  "description": "One conformance kit scenario: the requirements it verifies, the profiles it applies to, and cases with their input, steps, and expected outcome.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "mycelia/v1"
    },
    "kind": {
      "const": "ConformanceFixture"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Fixture name; equals the file name without .yaml and the name used in Verification fields."
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements",
        "profiles",
        "description",
        "cases"
      ],
      "properties": {
        "requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^MYC-[A-Z]+-[0-9]{3}$"
          }
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "minimal",
              "standard",
              "high-assurance"
            ]
          }
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/case"
          }
        }
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "given",
        "when",
        "expect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "description": {
          "type": "string"
        },
        "given": {
          "type": "object",
          "additionalProperties": false,
          "description": "Starting conditions. Sub-objects stay open in v2.0.0; the reference runtime (v2.1.0) tightens them.",
          "properties": {
            "workItem": {
              "type": "object"
            },
            "runState": {
              "type": "object"
            },
            "repository": {
              "type": "object"
            },
            "config": {
              "type": "object"
            },
            "runtime": {
              "type": "object"
            }
          }
        },
        "when": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "expect": {
          "$ref": "#/$defs/expect"
        },
        "profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "minimal",
              "standard",
              "high-assurance"
            ]
          },
          "description": "Profiles this case applies to when narrower than the fixture's; a case is not-applicable for other profiles."
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step"
      ],
      "properties": {
        "step": {
          "enum": [
            "start-run",
            "start-cycle",
            "start-second-run",
            "operator-start",
            "stop-runner",
            "restart-runtime",
            "engage-kill-switch",
            "consume-budget",
            "fail-check",
            "flake-check",
            "disconnect-trace",
            "trigger-ask",
            "block-run",
            "send-acknowledgement",
            "expire-acknowledgement",
            "send-reply",
            "send-owner-answer",
            "record-decision",
            "reject-decision",
            "push-change",
            "mark-ready",
            "enter-merge-queue",
            "advance-base",
            "update-base",
            "replay-step",
            "break-policy-statement",
            "place-host-marker",
            "propose-dependency-update",
            "reach-terminal-state",
            "attempt-denied-action"
          ]
        },
        "with": {
          "type": "object",
          "description": "Step parameters, for example the check that fails or the state to stop in."
        }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "terminalState",
        "runExitCode",
        "evidence"
      ],
      "properties": {
        "terminalState": {
          "enum": [
            "accepted",
            "rejected",
            "blocked",
            "aborted",
            "none"
          ],
          "description": "Terminal state of the work item; none when the case ends with no work item in a terminal state."
        },
        "runExitCode": {
          "type": "integer",
          "enum": [
            0,
            1,
            2,
            3,
            4,
            5,
            7
          ],
          "description": "Exit code of the run or work cycle under test (cli-contract.md section 5)."
        },
        "cycleOutcome": {
          "enum": [
            "progress",
            "stopped",
            "no-progress",
            "newly-blocked",
            "blocked-only",
            "idle"
          ]
        },
        "stateAfter": {
          "type": "string",
          "description": "Loop state the run resumes or restarts in, when the case checks it."
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z]+$"
          },
          "description": "Record kinds the run must produce; each is the kind of a schema in schemas/ (checked by scripts/check-fixture-names.sh)."
        },
        "trace": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "eventType"
            ],
            "properties": {
              "eventType": {
                "enum": [
                  "session",
                  "tool",
                  "permission",
                  "policy",
                  "evidence",
                  "state",
                  "review",
                  "acceptance",
                  "release",
                  "incident"
                ]
              },
              "action": {
                "type": "string"
              },
              "result": {
                "enum": [
                  "ok",
                  "error",
                  "denied",
                  "blocked"
                ]
              }
            }
          }
        },
        "absent": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Effects that must not happen, for example a second notification or a duplicate pull request."
        },
        "proposedTier": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3",
            "R4",
            "migration"
          ],
          "description": "The minimum risk tier the runtime proposes (MYC-CTL-007); migration means a DependencyTierRecord with migration true, at least R2."
        }
      }
    }
  }
}
