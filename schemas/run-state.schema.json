{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yutna/mycelia/schemas/run-state.schema.json",
  "title": "Mycelia Run State",
  "description": "The durable state of an autonomous run: current state, attempt, commit, budget, checkpoints, and terminal state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "mycelia/v1" },
    "kind": { "const": "RunState" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "createdAt", "updatedAt"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^RUN-[0-9]+$",
          "description": "Stable run identifier, for example RUN-001."
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workItemID",
        "state",
        "attempt",
        "commit",
        "branch",
        "role",
        "budget",
        "checkpoints"
      ],
      "properties": {
        "workItemID": { "type": "string", "minLength": 1 },
        "state": {
          "enum": [
            "intake",
            "planned",
            "implementing",
            "verifying",
            "reviewing",
            "accepting",
            "merging",
            "observing",
            "accepted",
            "rejected",
            "blocked",
            "aborted"
          ]
        },
        "attempt": { "type": "integer", "minimum": 1 },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "branch": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "model": { "type": "string" },
        "policyVersion": { "type": "string" },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["steps", "tokens", "costUSD"],
          "properties": {
            "steps": { "type": "integer", "minimum": 0 },
            "tokens": { "type": "integer", "minimum": 0 },
            "costUSD": { "type": "number", "minimum": 0 }
          }
        },
        "checkpoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "at", "commit"],
            "properties": {
              "state": { "type": "string", "minLength": 1 },
              "at": { "type": "string", "format": "date-time" },
              "commit": { "type": "string", "minLength": 1 },
              "note": { "type": "string" }
            }
          }
        },
        "terminalState": {
          "enum": ["accepted", "rejected", "blocked", "aborted"]
        },
        "reason": { "type": "string" },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "traceRef": { "type": "string" }
      }
    }
  }
}
