{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yutna/mycelia/schemas/run-state.schema.json",
  "title": "Mycelia Run State",
  "description": "The durable state of an autonomous run: current state, attempt, commit, budget, checkpoints, and terminal state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "mycelia/v1" },
    "kind": { "const": "RunState" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "createdAt", "updatedAt"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^RUN-[0-9]+$",
          "description": "Stable run identifier, for example RUN-001."
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workItemID",
        "state",
        "attempt",
        "commit",
        "branch",
        "role",
        "budget",
        "checkpoints"
      ],
      "properties": {
        "workItemID": { "type": "string", "minLength": 1 },
        "state": {
          "enum": [
            "intake",
            "planned",
            "implementing",
            "verifying",
            "reviewing",
            "accepting",
            "merging",
            "observing",
            "accepted",
            "rejected",
            "blocked",
            "aborted"
          ]
        },
        "attempt": { "type": "integer", "minimum": 1 },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "branch": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "model": { "type": "string" },
        "policyVersion": { "type": "string" },
        "startedBy": {
          "enum": ["scheduler", "operator"],
          "description": "Who started the run (MYC-EXE-005): the scheduler, or an operator command at L2."
        },
        "lease": {
          "type": "object",
          "additionalProperties": false,
          "required": ["acquiredAt", "worktree"],
          "description": "The exclusive claim this run holds on its work item (MYC-EXE-004, MYC-EXE-006).",
          "properties": {
            "acquiredAt": { "type": "string", "format": "date-time" },
            "worktree": { "type": "string", "minLength": 1 },
            "releasedAt": { "type": "string", "format": "date-time" },
            "releaseReason": { "enum": ["terminal", "stale", "checkpoint"] }
          }
        },
        "heartbeat": {
          "type": "object",
          "additionalProperties": false,
          "required": ["interval", "lastAt"],
          "description": "Heartbeat of an active run (MYC-EXE-005); a last heartbeat older than the stale-run threshold makes the run stale.",
          "properties": {
            "interval": {
              "type": "string",
              "pattern": "^P(?=[0-9T])([0-9]+D)?(T(?=[0-9])([0-9]+H)?([0-9]+M)?([0-9]+S)?)?$",
              "description": "ISO 8601 duration, from the mycelia.yaml runtime section."
            },
            "lastAt": { "type": "string", "format": "date-time" }
          }
        },
        "budgetLedgerRef": {
          "type": "string",
          "minLength": 1,
          "description": "The work item's BudgetLedger, which counts consumption across runs and restarts (MYC-EXE-007)."
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["steps", "tokens", "costUSD"],
          "properties": {
            "steps": { "type": "integer", "minimum": 0 },
            "tokens": { "type": "integer", "minimum": 0 },
            "costUSD": { "type": "number", "minimum": 0 }
          }
        },
        "checkpoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "at", "commit", "workItemVersion"],
            "description": "A checkpoint as listed in autonomous-loop.md section 6.",
            "properties": {
              "state": { "type": "string", "minLength": 1 },
              "at": { "type": "string", "format": "date-time" },
              "commit": { "type": "string", "minLength": 1 },
              "branch": { "type": "string", "minLength": 1 },
              "workItemVersion": {
                "type": "string",
                "minLength": 1,
                "description": "Revision or content hash of the work item's contract fields (goal, acceptance criteria, non-goals, constraints, risk tier, data class, affected areas); recording open questions and answers does not change it (MYC-EXE-017, MYC-EXE-019 fence 2)."
              },
              "role": { "type": "string", "minLength": 1 },
              "model": { "type": "string" },
              "policyVersion": { "type": "string" },
              "budgetConsumed": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "steps": { "type": "integer", "minimum": 0 },
                  "tokens": { "type": "integer", "minimum": 0 },
                  "costUSD": { "type": "number", "minimum": 0 }
                }
              },
              "evidenceRefs": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "openQuestions": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "traceEvent": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        },
        "terminalState": {
          "enum": ["accepted", "rejected", "blocked", "aborted"]
        },
        "reason": { "type": "string" },
        "evidenceRefs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "traceRef": { "type": "string" }
      }
    }
  }
}
