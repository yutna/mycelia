{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yutna/mycelia/schemas/work-item.schema.json",
  "title": "Mycelia Work Item",
  "description": "The unit of work for a Mycelia factory: goal, acceptance criteria, risk tier, evidence, and approvals.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "mycelia/v1" },
    "kind": { "const": "WorkItem" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "createdAt"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^MYC-[0-9]+$",
          "description": "Stable identifier, for example MYC-123."
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "owner": { "type": "string", "minLength": 1 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "acceptanceCriteria",
        "nonGoals",
        "constraints",
        "riskTier",
        "dataClass",
        "evidence"
      ],
      "properties": {
        "goal": { "type": "string", "minLength": 1 },
        "context": { "type": "string" },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "nonGoals": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "riskTier": { "enum": ["R0", "R1", "R2", "R3", "R4"] },
        "autonomyLevel": { "enum": ["L0", "L1", "L2", "L3", "L4"] },
        "dataClass": { "enum": ["public", "internal", "confidential", "secret"] },
        "affectedAreas": {
          "type": "array",
          "description": "Repository path globs the change may touch; required as globs for a recorded decision (MYC-EXE-019 fence 3).",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "rollback": { "type": "string", "minLength": 1 },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "approvals": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "openQuestions": {
          "type": "array",
          "description": "Questions recorded under the ambiguity protocol (failure-and-ambiguity.md section 5) and their answers (MYC-EXE-017).",
          "items": { "$ref": "#/$defs/question" }
        },
        "links": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "riskTier": { "enum": ["R2", "R3", "R4"] } },
            "required": ["riskTier"]
          },
          "then": { "required": ["rollback"] }
        },
        {
          "if": {
            "properties": { "riskTier": { "enum": ["R3", "R4"] } },
            "required": ["riskTier"]
          },
          "then": { "required": ["approvals"] }
        }
      ]
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "options", "askedAt", "runID", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "question": { "type": "string", "minLength": 1 },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["option", "consequence"],
            "properties": {
              "option": { "type": "string", "minLength": 1 },
              "consequence": { "type": "string", "minLength": 1 }
            }
          }
        },
        "recommendation": { "type": "string", "minLength": 1 },
        "askedAt": { "type": "string", "format": "date-time" },
        "runID": { "type": "string", "minLength": 1 },
        "status": { "enum": ["open", "answered", "withdrawn"] },
        "answerRef": {
          "type": "string",
          "minLength": 1,
          "description": "The OwnerAnswerRecord that answered the question."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "answered" } } },
          "then": { "required": ["answerRef"] },
          "else": { "not": { "required": ["answerRef"] } }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "threshold": { "type": "string" },
        "verifier": { "type": "string" }
      }
    }
  }
}
