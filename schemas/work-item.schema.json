{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yutna/mycelia/schemas/work-item.schema.json",
  "title": "Mycelia Work Item",
  "description": "The unit of work for a Mycelia factory: goal, acceptance criteria, risk tier, evidence, and approvals.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "mycelia/v1" },
    "kind": { "const": "WorkItem" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "createdAt"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^MYC-[0-9]+$",
          "description": "Stable identifier, for example MYC-123."
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "owner": { "type": "string", "minLength": 1 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "acceptanceCriteria",
        "nonGoals",
        "constraints",
        "riskTier",
        "dataClass",
        "evidence"
      ],
      "properties": {
        "goal": { "type": "string", "minLength": 1 },
        "context": { "type": "string" },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "nonGoals": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "riskTier": { "enum": ["R0", "R1", "R2", "R3", "R4"] },
        "autonomyLevel": { "enum": ["L0", "L1", "L2", "L3", "L4"] },
        "dataClass": { "enum": ["public", "internal", "confidential", "secret"] },
        "affectedAreas": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "rollback": { "type": "string", "minLength": 1 },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "approvals": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "links": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "riskTier": { "enum": ["R2", "R3", "R4"] } },
            "required": ["riskTier"]
          },
          "then": { "required": ["rollback"] }
        },
        {
          "if": {
            "properties": { "riskTier": { "enum": ["R3", "R4"] } },
            "required": ["riskTier"]
          },
          "then": { "required": ["approvals"] }
        }
      ]
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "threshold": { "type": "string" },
        "verifier": { "type": "string" }
      }
    }
  }
}
