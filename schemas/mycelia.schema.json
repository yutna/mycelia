{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yutna/mycelia/schemas/mycelia.schema.json",
  "title": "Mycelia Factory Configuration",
  "description": "The root configuration for an adopting repository: profile, autonomy, runtime, risk tiers, evidence, budgets, and observability.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "mycelia/v1" },
    "kind": { "const": "MyceliaConfig" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repository", "createdAt"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "owner": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "autonomy",
        "runtime",
        "riskTiers",
        "evidenceManifest"
      ],
      "properties": {
        "profile": { "enum": ["minimal", "standard", "high-assurance"] },
        "autonomy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ceiling"],
          "properties": {
            "ceiling": { "enum": ["L0", "L1", "L2", "L3", "L4"] },
            "default": { "enum": ["L0", "L1", "L2", "L3", "L4"] }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "const": "opencode" },
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "config": { "type": "string" }
          }
        },
        "riskTiers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["R0", "R1", "R2", "R3", "R4"],
          "properties": {
            "R0": { "type": "string", "minLength": 1 },
            "R1": { "type": "string", "minLength": 1 },
            "R2": { "type": "string", "minLength": 1 },
            "R3": { "type": "string", "minLength": 1 },
            "R4": { "type": "string", "minLength": 1 }
          }
        },
        "evidenceManifest": { "type": "string", "minLength": 1 },
        "roles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "policies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxCostUSD": { "type": "number", "minimum": 0 },
            "maxTokens": { "type": "integer", "minimum": 0 },
            "maxSteps": { "type": "integer", "minimum": 0 },
            "maxConcurrency": { "type": "integer", "minimum": 1 }
          }
        },
        "observability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "traceSink": { "type": "string" },
            "retentionDays": { "type": "integer", "minimum": 1 }
          }
        },
        "dataClasses": {
          "type": "array",
          "items": { "enum": ["public", "internal", "confidential", "secret"] }
        }
      }
    }
  }
}
