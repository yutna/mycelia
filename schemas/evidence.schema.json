{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yutna/mycelia/schemas/evidence.schema.json",
  "title": "Mycelia Evidence",
  "description": "A single evidence record: what was produced, by whom, for which commit, with which hash and verifier.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "mycelia/v1" },
    "kind": { "const": "Evidence" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "createdAt"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EVD-[A-Z0-9-]+$",
          "description": "Stable evidence identifier, for example EVD-LINT-001."
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestID",
        "requirementID",
        "type",
        "producer",
        "verifier",
        "commit",
        "command",
        "environment",
        "timestamp",
        "hash",
        "result",
        "verifiedAt"
      ],
      "properties": {
        "manifestID": { "type": "string", "minLength": 1 },
        "requirementID": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "producer": { "type": "string", "minLength": 1 },
        "verifier": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "command": { "type": "string", "minLength": 1 },
        "environment": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "format": "date-time" },
        "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "location": { "type": "string" },
        "result": { "enum": ["pass", "fail", "blocked", "skipped"] },
        "skipRule": {
          "type": "string",
          "minLength": 1,
          "description": "The configured skip rule that skipped the layer (MYC-ASR-005)."
        },
        "replacementEvidenceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Evidence that replaces a skipped layer, at the same commit (MYC-ASR-005)."
        },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "trigger", "selectionMapVersion", "selectedChecks", "duration"],
          "description": "The gate run that produced this result (verification-stack.md section 12).",
          "properties": {
            "name": { "enum": ["fast", "full"] },
            "trigger": {
              "enum": ["push", "selection-fallback", "ready", "merge-queue", "schedule", "release", "risk-tier", "flake-rerun"],
              "description": "Why the gate ran (MYC-ASR-001, MYC-ASR-002, MYC-ASR-004)."
            },
            "selectionMapVersion": { "type": "string", "minLength": 1 },
            "selectedChecks": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "description": "Checks the selection map selected; empty for a full gate."
            },
            "duration": {
              "type": "string",
              "pattern": "^P(?=[0-9T])([0-9]+D)?(T(?=[0-9])([0-9]+H)?([0-9]+M)?([0-9]+S)?)?$",
              "description": "Job start to verdict on the reference runner, as an ISO 8601 duration."
            },
            "countsAgainstBudget": {
              "type": "boolean",
              "description": "True for a pre-merge full-gate run counted in the budget ledger (MYC-ASR-004)."
            }
          }
        },
        "verifiedAt": { "type": "string", "format": "date-time" },
        "traceEvent": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "result": { "const": "skipped" } } },
          "then": { "required": ["skipRule", "replacementEvidenceRefs"] },
          "else": { "not": { "anyOf": [{ "required": ["skipRule"] }, { "required": ["replacementEvidenceRefs"] }] } }
        }
      ]
    }
  }
}
