{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yutna/mycelia/schemas/policy-decision.schema.json",
  "title": "Mycelia Policy Decision",
  "description": "The record of a policy decision: policy version, subject, action, resource, effect, reason, and obligations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "mycelia/v1" },
    "kind": { "const": "PolicyDecision" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "createdAt"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^PD-[0-9]+$",
          "description": "Stable decision identifier, for example PD-001."
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "subject",
        "action",
        "resource",
        "effect",
        "reason",
        "timestamp"
      ],
      "properties": {
        "policy": { "type": "string", "minLength": 1 },
        "policyVersion": { "type": "string" },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "session"],
          "properties": {
            "role": { "type": "string", "minLength": 1 },
            "session": { "type": "string", "minLength": 1 },
            "actor": { "type": "string", "minLength": 1 }
          }
        },
        "action": { "type": "string", "minLength": 1 },
        "resource": { "type": "string", "minLength": 1 },
        "effect": { "enum": ["allow", "deny", "escalate"] },
        "reason": { "type": "string", "minLength": 1 },
        "obligations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  }
}
