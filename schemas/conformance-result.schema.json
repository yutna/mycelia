{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yutna/mycelia/schemas/conformance-result.schema.json",
  "title": "Mycelia Conformance Result",
  "description": "The result of running the conformance kit against a runtime for one profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "mycelia/v1"
    },
    "kind": {
      "const": "ConformanceResult"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CONF-[A-Z0-9-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "opencodeVersion",
        "kit",
        "profile",
        "repository",
        "results",
        "summary",
        "outcome",
        "partial"
      ],
      "properties": {
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "opencodeVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"
        },
        "kit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "commit"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          }
        },
        "profile": {
          "enum": [
            "minimal",
            "standard",
            "high-assurance"
          ]
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commit"
          ],
          "properties": {
            "url": {
              "type": "string"
            },
            "commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          }
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fixture",
              "case",
              "status"
            ],
            "properties": {
              "fixture": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "case": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "error",
                  "not-applicable"
                ]
              },
              "observed": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "terminalState": {
                    "enum": [
                      "accepted",
                      "rejected",
                      "blocked",
                      "aborted",
                      "none"
                    ]
                  },
                  "runExitCode": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cycleOutcome": {
                    "enum": [
                      "progress",
                      "stopped",
                      "no-progress",
                      "newly-blocked",
                      "blocked-only",
                      "idle"
                    ]
                  }
                }
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "passed",
            "failed",
            "errors",
            "notApplicable"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "passed": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "errors": {
              "type": "integer",
              "minimum": 0
            },
            "notApplicable": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "outcome": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "partial": {
          "type": "boolean",
          "description": "True when the run used --only or a --fixtures override; a partial result never supports a claim."
        },
        "fixturesSource": {
          "type": "string",
          "description": "Where the fixtures came from when not the pinned kit."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "pass"
              }
            }
          },
          "then": {
            "properties": {
              "partial": {
                "const": false
              },
              "summary": {
                "properties": {
                  "failed": {
                    "const": 0
                  },
                  "errors": {
                    "const": 0
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "fixturesSource"
            ]
          },
          "then": {
            "properties": {
              "partial": {
                "const": true
              }
            }
          }
        }
      ]
    }
  }
}
