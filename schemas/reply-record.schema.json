{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yutna/mycelia/schemas/reply-record.schema.json",
  "title": "Mycelia Reply Record",
  "description": "A reply to an open question from a person without the decision right; recorded, never clears the block (MYC-EXE-017).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "mycelia/v1"
    },
    "kind": {
      "const": "ReplyRecord"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^RPL-[A-Z0-9-]+$",
          "description": "Stable identifier, for example RPL-001."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workItemID",
        "questionID",
        "author",
        "at",
        "text",
        "clearsBlock"
      ],
      "properties": {
        "workItemID": {
          "type": "string",
          "minLength": 1
        },
        "questionID": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "clearsBlock": {
          "const": false
        },
        "traceEvent": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
