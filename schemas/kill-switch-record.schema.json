{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yutna/mycelia/schemas/kill-switch-record.schema.json",
  "title": "Mycelia Kill Switch Record",
  "description": "An engagement, release, or drill of the kill switch (MYC-EXE-008; budgets-and-kill-switch.md section 8 and 10).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "mycelia/v1"
    },
    "kind": {
      "const": "KillSwitchRecord"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^KSW-[A-Z0-9-]+$",
          "description": "Stable identifier, for example KSW-001."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "target",
        "trigger",
        "engagedBy",
        "engagedAt",
        "drill"
      ],
      "properties": {
        "scope": {
          "enum": [
            "run",
            "repository"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "The run or repository the switch stops."
        },
        "trigger": {
          "enum": [
            "budget-exhaustion",
            "security-incident",
            "policy-violation",
            "runaway-loop",
            "data-exfiltration",
            "compromised-component",
            "drill"
          ]
        },
        "engagedBy": {
          "type": "string",
          "minLength": 1
        },
        "engagedAt": {
          "type": "string",
          "format": "date-time"
        },
        "interruptedSessions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stoppedAt": {
          "type": "string",
          "format": "date-time"
        },
        "releasedBy": {
          "type": "string",
          "minLength": 1,
          "description": "The human who released the switch; an agent cannot release it."
        },
        "releasedAt": {
          "type": "string",
          "format": "date-time"
        },
        "drill": {
          "type": "boolean"
        },
        "traceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
